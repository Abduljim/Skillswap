// Prisma schema for SkillSwap
// PostgreSQL with deterministic matching (no LLM)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillType {
  TEACH
  WANT
}

enum LearningFormat {
  ONLINE
  IN_PERSON
  EITHER
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  EVENING
}

enum ExchangeRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ExchangeStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CallType {
  VOICE
  VIDEO
}

enum CallOutcome {
  COMPLETED
  DECLINED
  MISSED
}

enum SessionFormat {
  ONLINE
  IN_PERSON
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String
  displayName   String
  isActive      Boolean  @default(true)
  isAdmin       Boolean  @default(false)
  // Bumped to invalidate every JWT issued before the bump (logout, password
  // change/reset, admin deactivation). Tokens carry the value they were minted
  // with; a mismatch means the session was revoked.
  tokenVersion  Int      @default(0)
  lastLoginAt   DateTime?
  loginStreak   Int      @default(0)
  maxStreak     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile               Profile?
  userSkills            UserSkill[]
  sentRequests          ExchangeRequest[] @relation("RequestSender")
  receivedRequests      ExchangeRequest[] @relation("RequestReceiver")
  exchangesAsA          Exchange[]        @relation("ExchangeUserA")
  exchangesAsB          Exchange[]        @relation("ExchangeUserB")
  messages              Message[]
  reviewsGiven          Review[]          @relation("Reviewer")
  reviewsReceived       Review[]          @relation("Reviewed")
  notifications         Notification[]
  reportsFiled          Report[]          @relation("Reporter")
  reportsAgainst        Report[]          @relation("Reported")
  blocksGiven           Block[]           @relation("Blocker")
  blocksReceived        Block[]           @relation("Blocked")
  passwordResetTokens   PasswordResetToken[]
  completionConfirmations ExchangeCompletionConfirmation[]
  subscription          Subscription?
  profileViewsMade      ProfileView[]     @relation("ProfileViewer")
  profileViewsReceived  ProfileView[]     @relation("ProfileViewed")
  boosts                Boost[]
  pushTokens            PushToken[]

  @@index([email])
  @@index([isActive])
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Profile {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @unique @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  university      String?
  department      String?
  yearLevel       String?
  occupation      String?
  jobTitle        String?
  company         String?
  gender          String?
  age             Int?
  bio             String?
  avatarUrl       String?
  learningFormat  LearningFormat  @default(EITHER)
  avatarFrame     String          @default("linen")
  bannerStyle     String          @default("cream")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  availabilities  Availability[]
}

model Availability {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  weekday   Weekday
  timeOfDay TimeOfDay

  @@unique([profileId, weekday, timeOfDay])
  @@index([profileId])
}

model Skill {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  category    String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  userSkills      UserSkill[]
  offeredIn       ExchangeRequest[] @relation("OfferedSkill")
  requestedIn     ExchangeRequest[] @relation("RequestedSkill")

  @@index([category])
  @@index([isActive])
}

model UserSkill {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId     String       @db.Uuid
  skill       Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  type        SkillType
  proficiency Proficiency  @default(INTERMEDIATE)
  createdAt   DateTime     @default(now())

  @@unique([userId, skillId, type])
  @@index([userId])
  @@index([skillId])
}

model ExchangeRequest {
  id              String               @id @default(uuid()) @db.Uuid
  senderId        String               @db.Uuid
  sender          User                 @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId      String               @db.Uuid
  receiver        User                 @relation("RequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  offeredSkillId  String               @db.Uuid
  offeredSkill    Skill                @relation("OfferedSkill", fields: [offeredSkillId], references: [id])
  requestedSkillId String              @db.Uuid
  requestedSkill  Skill                @relation("RequestedSkill", fields: [requestedSkillId], references: [id])
  message         String
  status          ExchangeRequestStatus @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  exchange        Exchange?

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model Exchange {
  id           String                    @id @default(uuid()) @db.Uuid
  requestId    String?                   @unique @db.Uuid
  request      ExchangeRequest?          @relation(fields: [requestId], references: [id])
  userAId      String                    @db.Uuid
  userA        User                      @relation("ExchangeUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId      String                    @db.Uuid
  userB        User                      @relation("ExchangeUserB", fields: [userBId], references: [id], onDelete: Cascade)
  skillAId     String                    @db.Uuid
  skillBId     String                    @db.Uuid
  status       ExchangeStatus            @default(ACTIVE)
  createdAt    DateTime                  @default(now())
  completedAt  DateTime?
  updatedAt    DateTime                  @updatedAt

  sessions     Session[]
  messages     Message[]
  reviews      Review[]
  completions  ExchangeCompletionConfirmation[]
  callLogs     CallLog[]

  @@unique([userAId, userBId, skillAId, skillBId, status], name: "unique_active_exchange")
  @@index([userAId])
  @@index([userBId])
  @@index([status])
}

model ExchangeCompletionConfirmation {
  id          String     @id @default(uuid()) @db.Uuid
  exchangeId  String     @db.Uuid
  exchange    Exchange   @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  confirmedAt DateTime   @default(now())

  @@unique([exchangeId, userId])
}

model Session {
  id              String        @id @default(uuid()) @db.Uuid
  exchangeId      String        @db.Uuid
  exchange        Exchange      @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  title           String
  scheduledAt     DateTime
  durationMinutes Int
  format          SessionFormat
  meetingLink     String?
  location        String?
  notes           String?
  status          SessionStatus @default(SCHEDULED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([exchangeId])
  @@index([status])
  @@index([scheduledAt])
}

model CallLog {
  id         String     @id @default(uuid()) @db.Uuid
  exchangeId String     @db.Uuid
  exchange   Exchange   @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  callerId   String     @db.Uuid
  calleeId   String     @db.Uuid
  type       CallType
  outcome    CallOutcome @default(COMPLETED)
  startedAt  DateTime   @default(now())
  endedAt    DateTime?
  createdAt  DateTime   @default(now())

  @@index([exchangeId])
  @@index([callerId])
}

enum MessageType {
  TEXT
  IMAGE
  STICKER
}

model Message {
  id         String      @id @default(uuid()) @db.Uuid
  exchangeId String      @db.Uuid
  exchange   Exchange    @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  senderId   String      @db.Uuid
  sender     User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type       MessageType @default(TEXT)
  body       String
  caption    String?
  createdAt  DateTime    @default(now())
  status     String      @default("SENT")
  readAt     DateTime?

  @@index([exchangeId, createdAt])
  @@index([senderId])
}

model Review {
  id             String   @id @default(uuid()) @db.Uuid
  exchangeId     String   @db.Uuid
  exchange       Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  reviewerId     String   @db.Uuid
  reviewer       User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUserId String   @db.Uuid
  reviewedUser   User     @relation("Reviewed", fields: [reviewedUserId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  @@unique([exchangeId, reviewerId])
  @@index([reviewedUserId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  payload   Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model Report {
  id            String       @id @default(uuid()) @db.Uuid
  reporterId    String       @db.Uuid
  reporter      User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String      @db.Uuid
  reportedUser  User         @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason        String
  description   String
  status        ReportStatus @default(OPEN)
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?

  @@index([reportedUserId])
  @@index([status])
}

model Block {
  id            String   @id @default(uuid()) @db.Uuid
  blockerId     String   @db.Uuid
  blocker       User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String   @db.Uuid
  blockedUser   User     @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedUserId])
  @@index([blockerId])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum SubscriptionTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum BillingPlatform {
  WEB
  ANDROID
  IOS
}

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @unique @db.Uuid
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier              SubscriptionTier   @default(FREE)
  status            SubscriptionStatus @default(ACTIVE)
  platform          BillingPlatform?
  purchaseToken     String?            @unique
  productId         String?
  orderId           String?            @unique
  startedAt         DateTime           @default(now())
  expiresAt         DateTime?
  cancelledAt       DateTime?
  autoRenew         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([expiresAt])
}

model ProfileView {
  id          String   @id @default(uuid()) @db.Uuid
  viewerId    String   @db.Uuid
  viewer      User     @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  profileId   String   @db.Uuid
  profile     User     @relation("ProfileViewed", fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([viewerId])
}

model Boost {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt    DateTime @default(now())
  endsAt      DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([endsAt])
}