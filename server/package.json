{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:prod": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js --packages=external && esbuild src/catalogue.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/catalogue.js",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "prisma:generate": "node scripts/prisma-env.js generate",
    "migrate": "node scripts/prisma-env.js migrate dev",
    "migrate:deploy": "node scripts/ensure-migrations.js && node scripts/prisma-env.js migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "lint": "tsc --noEmit",
    "studio": "node scripts/prisma-env.js studio",
    "db:baseline": "node scripts/ensure-migrations.js",
    "test:db:prepare": "node scripts/prisma-env.js --test db push --skip-generate",
    "test:integration": "npm run test:db:prepare && jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^9.14.1",
    "googleapis": "^178.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^20.17.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
