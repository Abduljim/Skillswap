# ===================================
# SKILLSWAP ENVIRONMENT VARIABLES
# ===================================

# Node Environment
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillswap?schema=public
# Dedicated database for `npm test` — integration tests TRUNCATE it on every run.
# Must be a different database from DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillswap_test?schema=public

# JWT
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=replace-with-another-long-random-string

# Client URL — CORS allowlist (comma-separated). '*' means "not configured",
# NOT "allow everything": the API then permits only its own origin plus the
# Capacitor WebView origins (https://localhost, capacitor://localhost).
# An arbitrary Origin is never reflected, because credentials are enabled.
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
# Extra origins to allow, comma-separated (e.g. a marketing site).
EXTRA_ALLOWED_ORIGINS=

# Email (used for password reset) — Resend is recommended
# 1) RESEND_API_KEY is the simplest (no SMTP needed)
# 2) or classic SMTP below
RESEND_API_KEY=
EMAIL_FROM=SkillSwap <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Web billing — grants PRO from POST /api/subscription/web with NO payment
# provider. Production refuses it unless this is exactly "true"; leaving it empty
# keeps it available in development so the paywall UI can be exercised.
ENABLE_WEB_BILLING=

# Play Billing (Android)
# Path to your service-account JSON for Google Play Developer API verification
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Package name of your Android app (must match Play Console)
ANDROID_PACKAGE_NAME=app.skillswap.client
# Whether to enforce Google Play verification (set to 'true' in production)
PLAY_BILLING_VERIFY=false

# Firebase Cloud Messaging — rings for incoming calls when the app is closed.
# Recommended: paste the full Firebase service-account JSON (Project Settings →
# Service accounts → Generate new private key) into FCM_SERVICE_ACCOUNT_JSON.
# Alternatively, the legacy "Server key" from Cloud Messaging can be used.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVER_KEY=