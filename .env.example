# ===================================
# SKILLSWAP ENVIRONMENT VARIABLES
# ===================================

# Node Environment
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillswap?schema=public
# Dedicated database for `npm test` — integration tests TRUNCATE it on every run.
# Must be a different database from DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillswap_test?schema=public

# JWT
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=replace-with-another-long-random-string

# Client URL — CORS allowlist (comma-separated). '*' means "not configured",
# NOT "allow everything": the API then permits only its own origin plus the
# Capacitor WebView origins (https://localhost, capacitor://localhost).
# An arbitrary Origin is never reflected, because credentials are enabled.
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
# Extra origins to allow, comma-separated (e.g. a marketing site).
EXTRA_ALLOWED_ORIGINS=

# Email — used for exactly one thing: password reset. See docs/EMAIL.md.
# With these empty the failure is SILENT: auth.service.ts swallows the error so
# the endpoint cannot leak which addresses exist, and "Forgot password" looks
# like it worked while no mail is ever sent.
# RESEND_API_KEY only works if you OWN AND HAVE VERIFIED A DOMAIN. Unverified,
# Resend sends from onboarding@resend.dev to YOUR OWN SIGNUP ADDRESS ONLY, so it
# passes every test you run against yourself and rejects every real user.
# No domain yet? Leave it empty and use SMTP below (Gmail App Password, 500/day,
# or Brevo's relay, 300/day — neither needs a card or a domain).
# SMTP needs BOTH SMTP_HOST and SMTP_FROM (isSmtpConfigured checks both).
# Port 587 => STARTTLS, port 465 => implicit TLS. Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char App Password, NOT your Gmail password>
#   SMTP_FROM=SkillSwap <you@gmail.com>
RESEND_API_KEY=
EMAIL_FROM=SkillSwap <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Web billing — grants PRO from POST /api/subscription/web with NO payment
# provider. Production refuses it unless this is exactly "true"; leaving it empty
# keeps it available in development so the paywall UI can be exercised.
ENABLE_WEB_BILLING=

# Play Billing (Android)
# Path to your service-account JSON for Google Play Developer API verification
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Package name of your Android app (must match Play Console)
ANDROID_PACKAGE_NAME=app.skillswap.client
# Whether to enforce Google Play verification (set to 'true' in production)
PLAY_BILLING_VERIFY=false

# Firebase Cloud Messaging — rings for incoming calls when the app is closed.
# Recommended: paste the full Firebase service-account JSON (Project Settings →
# Service accounts → Generate new private key) into FCM_SERVICE_ACCOUNT_JSON.
# Alternatively, the legacy "Server key" from Cloud Messaging can be used.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVER_KEY=

# ── WebRTC relay (TURN) ─────────────────────────────────────────────────────
# STUN cannot connect two peers that are both behind carrier-grade NAT — the
# normal case on mobile data — so without a relay a large share of calls ring and
# then fail to connect. Full setup guide (free coturn on an Oracle Always Free
# VPS): docs/TURN.md.
#
# These are SERVER-side on purpose. GET /api/calls/ice-servers mints a short-lived
# credential per request (coturn's use-auth-secret REST scheme), so the secret
# never ships inside the web bundle or the APK and can be rotated without a
# rebuild. Startup log prints one line, e.g. "TURN ephemeral (3 urls, ttl 3600s)".
TURN_URLS=
# = coturn's static-auth-secret. Generate with: openssl rand -hex 32
TURN_SECRET=
# = coturn's realm. Must match, because the realm is half of the minted username.
TURN_REALM=turn.skillswap.app
# Credential lifetime in seconds. Must outlive a whole call: coturn re-checks it
# on every allocation refresh.
TURN_TTL_SECONDS=3600
# Only needed for providers that cannot do HMAC (Xirsys, Metered static keys), and
# only used when TURN_SECRET is empty. These DO reach the client.
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Group calls ─────────────────────────────────────────────────────────────
# Mesh: every participant opens a connection to every other, so n people means
# n*(n-1) streams and each phone uploads n-1 copies of itself. Capped, and groups
# start audio-only (video is opt-in per participant via the camera button, which
# renegotiates). Raise this only if you move to an SFU. Enforced by the socket
# layer and published to the UI by GET /api/calls/limits.
MAX_GROUP_CALL_PARTICIPANTS=4

# ── Client build (Vite) ─────────────────────────────────────────────────────
# These are baked into the web/APK bundle at build time, so they go in
# client/.env.production rather than the server environment.
#
# VITE_API_URL=https://your-api.onrender.com
#
# Optional TURN escape hatch, for an API that predates /api/calls/ice-servers or a
# provider that only issues static credentials. Everything here is readable by
# anyone who unpacks the bundle, and changing it needs a rebuild — prefer the
# server-side variables above and leave these empty.
# VITE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tls
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
